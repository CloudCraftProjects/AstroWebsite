---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Link from "../components/Link.astro";
import DiscordLink from "../components/DiscordLink.astro";
import DcUser from "../components/DcUser.astro";
import BaselineGavelIcon from "~icons/ic/baseline-gavel";
import BaselineDownloadIcon from "~icons/ic/baseline-download";
import BaselineEmailIcon from "~icons/ic/baseline-email";
import {teamMembers} from "../scripts/team.ts";
---

<Layout title="FAQ" description="Die am häufigsten gestellten Fragen über CloudCraft - hier beantwortet" keywords={["faq"]}>
    <Header title="FAQ">
        <p>Hier findest du Antworten auf die am häufigst gestellten Fragen.</p>
        <p>Du hast eine Frage, welche hier nicht beantwortet wird? Tritt unserem <DiscordLink/> bei, dort wird deine Frage vom CloudCraft-Team schnellstmöglich beantwortet.</p>
    </Header>
    <main class="section">
        <div class="container">
            <Breadcrumb items={[{href: "/", label: "Home"}, {label: "FAQ"}]}/>
            <div class="faq-item" id="rules">
                <h2>Gibt es ein generelles Regelwerk?</h2>
                <div class="faq-body">
                    <p>Ja, es gibt ein generelles <Link icon={BaselineGavelIcon} href="/rules">Regelwerk</Link>. Allerdings solltest du beachten, dass es in jedem Projekte zusätzliche Regeln geben könnte oder einige Regeln nicht gelten.</p>
                </div>
            </div>
            <div class="faq-item" id="team">
                <h2>Wer ist das CloudCraft Team?</h2>
                <div class="faq-body">
                    <p>Das CloudCraft Team besteht aus vielen Mitgliedern, die Spaß daran haben, für euch verschiedene Minecraft-Projekte auf die Beine zu stellen. Gegründet wurde der Server von <DcUser id="650258283185045507/">tschenikl</DcUser> und <DcUser id="351085754979450881/">niklas883</DcUser>. Aktuell besteht das Team aus {teamMembers.length} Teammitgliedern:</p>
                    <ul class="team">
                        {
                            teamMembers.map((member) => (
                                <li>
                                    <DcUser id={member.id}>{member.name}</DcUser>
                                    <span class="roles">: {member.roles.join(", ")}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
            <div class="faq-item" id="source">
                <h2>Kann man CraftAttack, Elements, etc. selbst nutzen?</h2>
                <div class="faq-body">
                    <p>Einige unserer System sind Open-Source. Auf unserer <Link icon={BaselineDownloadIcon} href="/r/downloads">Downloads</Link>-Seite können diese heruntergeladen werden. Allerdings ist nicht alles öffentlich verfügbar.</p>
                </div>
            </div>
            <div class="faq-item" id="contact">
                <h2>Wie kann man euch kontaktieren?</h2>
                <div class="faq-body">
                    <p>Die schnellste Kontaktmöglichkeit ist über unseren <DiscordLink/>. Dort kannst du per Ticket dem Team direkt eine Frage/ein Anliegen stellen.</p>
                    <p>Eine alternative Kontaktmöglichkeit wäre per &#69;-&#77;&#97;&#105;&#108; unter <Link icon={BaselineEmailIcon} href="mailto:info@cloudcraftmc.de">info@cloudcraftmc.de</Link> Bitte beachte, dass wir hier keine direkte Antwort garantieren können.</p>
                </div>
            </div>
            <div class="faq-item" id="downloads">
                <h2>Wo kann man die Maps der Projekte downloaden?</h2>
                <div class="faq-body">
                    <p>Wir haben eine extra Seite für alle Projekt-Downloads unter <Link icon={BaselineDownloadIcon} href="/r/downloads">downloads.cloudcraftmc.de</Link>.</p>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .section {
        padding: 2.5em 1em 3.5em;
    }
    .container {
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
    }
    #team .faq-body p {
        margin-bottom: 0.5em;
    }
    .team {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3em;
    }
    .team li {
        margin: 0;
    }
    .team .roles {
        font-weight: 500;
    }
    .faq-item {
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        margin: 0.75em 0;
    }
    .faq-item h2 {
        padding: 1.25rem 1.25rem;
        font-weight: 600;
        font-size: 1.5rem;
        margin: 0;
    }
    .faq-item .faq-body {
        padding: 0.25em 1.25rem 1.25rem;
        color: var(--text-muted);
    }
    .faq-item .faq-body p:last-child {
        margin-bottom: 0;
    }
</style>
