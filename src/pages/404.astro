---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";
---

<Layout title="Error 404" description="Die Seite konnte nicht gefunden werden" keywords={["404"]}>
    <main class="section">
        <div class="container">
            <p class="code" aria-hidden="true">404</p>
            <h1>Seite nicht gefunden</h1>
            <p class="lead">Die Seite, die du suchst, konnte leider nicht gefunden werden.</p>
            <div class="actions">
                <Link button={{variant: "secondary"}} href="/">Zur Homepage</Link>
            </div>
        </div>
    </main>
</Layout>

<style>
    .section {
        padding: 5em 1em;
    }
    .container {
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
        text-align: center;
    }
    .code {
        font-size: clamp(5rem, 18vw, 9rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0;
    }
    .container h1 {
        margin-top: 0.25em;
    }
    .lead {
        color: var(--text-muted);
        font-size: 1.15rem;
        max-width: 55ch;
        margin: 0.5em auto 1.75em;
    }
</style>
