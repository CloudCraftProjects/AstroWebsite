---
import type {SvgComponent} from "astro/types";

interface Props {
  icon: SvgComponent;
}

const { icon: Icon } = Astro.props;
---

<span>
    <Icon aria-hidden="true" />
    <slot />
</span>

<style>
    span {
        text-transform: uppercase;
        background-color: #9d1bb5;
        padding: 0.3em;
        border-radius: 0.2em;
        font-weight: bold;
        font-size: 0.9em;
        display: inline-flex;
        align-items: center;
        gap: 0.2em;
    }
</style>
