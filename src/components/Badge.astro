---
import type {SvgComponent} from "astro/types";

interface Props {
    icon?: SvgComponent;
}

const {icon: Icon} = Astro.props;
---

<span class="badge">
    {Icon && <Icon aria-hidden="true"/>}
    <slot/>
</span>

<style>
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.3em 0.8em;
        border-radius: var(--radius-md);
        background-color: var(--purple);
        color: var(--text);
        font-size: 1.15rem;
        font-weight: 600;
        text-transform: uppercase;
        line-height: 1.2;
    }
</style>
