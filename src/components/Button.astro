---
export interface ButtonProps {
    variant?: "primary" | "secondary" | "discord";
    size?: "sm" | "md" | "lg";
}
interface Props extends ButtonProps {}

const {variant = "secondary", size = "md"} = Astro.props;
---

<div class:list={["btn", variant, size]}>
    <slot/>
</div>
<style>
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;
        padding: 0.55em 1.4em;
        border-radius: var(--radius-lg);
        font-weight: 600;
        line-height: 1.2;
        cursor: pointer;
        transition:
            background-color var(--duration-base) var(--ease-out),
            border-color var(--duration-base) var(--ease-out),
            color var(--duration-base) var(--ease-out);
    }

    .primary {
        background-color: var(--accent-subtle);
        border: 1px solid var(--accent-border);
        color: var(--accent);
    }
    .primary:hover {
        color: var(--accent-hover);
        border-color: var(--accent);
        background-color: color-mix(in oklab, var(--accent) 22%, transparent);
    }

    .secondary {
        background-color: transparent;
        border: 1px solid var(--border-strong);
        color: var(--text);
    }
    .secondary:hover {
        background-color: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.3);
    }

    .discord {
        background-color: var(--discord);
        color: white;
    }
    .discord:hover {
        background-color: var(--discord-highlight);
    }

    .sm {
        padding: 0.35em 0.9em;
        font-size: 0.875em;
    }
    .lg {
        padding: 0.7em 1.7em;
        font-size: 1.05em;
    }
</style>
