---
import {Image} from "astro:assets";
import BaselineChevronLeftIcon from "~icons/ic/baseline-chevron-left";
import BaselineChevronRightIcon from "~icons/ic/baseline-chevron-right";

interface Props {
    projectId: string;
    slides: {
        img: string;
        title: string;
        description: string;
    }[];
    initialSlide?: number;
    slideWidth?: number;
    slideHeight?: number;
}

const {projectId, slides, initialSlide = 1, slideWidth = 1920, slideHeight = 1080} = Astro.props;
---

<div class="carousel" data-initial-slide={initialSlide} data-slide-count={slides.length}>
    <div class="slides">
        {
            slides.map(({img, title, description}, index) => (
                <div class:list={["slide", {active: index + 1 === initialSlide}]} data-slide={index + 1}>
                    <div class="image">
                        <Image
                            src={`/assets/projects/${projectId}/${img}.webp`}
                            alt={`${title}. ${description}`}
                            width={slideWidth}
                            height={slideHeight}
                        />
                        <button class="arrow previous" type="button" aria-label="Vorheriges Bild">
                            <BaselineChevronLeftIcon aria-hidden="true"/>
                        </button>
                        <button class="arrow next" type="button" aria-label="Nächstes Bild">
                            <BaselineChevronRightIcon aria-hidden="true"/>
                        </button>
                    </div>
                    <div class="caption" aria-hidden="true">
                        <p class="title">{title}</p>
                        <p class="description">{description}</p>
                    </div>
                </div>
            ))
        }
    </div>
    <div class="indicators">
        {
            slides.map((_, index) => (
                <button
                    class:list={["indicator", {active: index + 1 === initialSlide}]}
                    data-slide={index + 1}
                    type="button"
                    aria-label={`Bild ${index + 1} anzeigen`}
                />
            ))
        }
    </div>
</div>

<script>
    const setupCarousel = (container: HTMLElement) => {
        const slideCount = Number(container.dataset.slideCount);
        let selectedSlide = Number(container.dataset.initialSlide);
        let switchJob: ReturnType<typeof setTimeout> | undefined;

        const getSlide = (slideIndex: number) =>
            container.querySelector<HTMLElement>(`.slide[data-slide="${slideIndex}"]`)!;
        const getIndicator = (slideIndex: number) =>
            container.querySelector<HTMLElement>(`.indicator[data-slide="${slideIndex}"]`)!;

        const startSwitchJob = () => {
            clearTimeout(switchJob);
            switchJob = setTimeout(() => switchSlide(1), 5000);
        };
        const changeSlide = (slideIndex: number) => {
            getSlide(selectedSlide).classList.remove("active");
            getIndicator(selectedSlide).classList.remove("active");
            getSlide(slideIndex).classList.add("active");
            getIndicator(slideIndex).classList.add("active");
            selectedSlide = slideIndex;
            startSwitchJob();
        };
        const switchSlide = (offset: number) => {
            let newSlide = (selectedSlide + offset - 1) % slideCount;
            if (newSlide < 0) {
                newSlide += slideCount;
            }
            changeSlide(newSlide + 1);
        };

        container.querySelector(".indicators")!.addEventListener("click", (event) => {
            const indicator = (event.target as HTMLElement).closest(".indicator") as HTMLElement | null;
            if (indicator) {
                changeSlide(Number(indicator.dataset.slide));
            }
        });
        container.querySelector(".slides")!.addEventListener("click", (event) => {
            const arrow = (event.target as HTMLElement).closest(".arrow");
            if (!arrow) return;
            switchSlide(arrow.classList.contains("next") ? 1 : -1);
        });
        container.addEventListener("mouseenter", () => clearTimeout(switchJob));
        container.addEventListener("mouseleave", startSwitchJob);

        startSwitchJob();
    };
    document.querySelectorAll<HTMLElement>(".carousel").forEach(setupCarousel);
</script>

<style>
    .carousel {
        display: flex;
        flex-direction: column;
        margin-top: 1em;
        margin-bottom: 1em;
    }
    .slides {
        position: relative;
    }
    .slide {
        display: none;
    }
    .slide.active {
        display: block;
    }
    .slide .image {
        position: relative;
        border-radius: var(--radius-sm);
        overflow: hidden;
    }
    .slide .image img {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: var(--radius-sm);
    }
    .slide .caption {
        position: absolute;
        bottom: 0;
        width: 100%;
        text-align: center;
        padding: 3.5em 1em 1.25em;
        text-shadow: black 0 0 0.3em, black 0 0 0.6em, black 0 0 0.9em;
        border-bottom-left-radius: var(--radius-lg);
        border-bottom-right-radius: var(--radius-lg);
    }
    .caption .title {
        font-weight: 600;
        font-size: 1.15em;
    }
    .caption p {
        margin: 0;
    }
    .arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border-radius: 50%;
        background-color: rgba(11, 15, 25, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: var(--text);
        font: inherit;
        font-size: 1.25rem;
        cursor: pointer;
        transition:
            background-color var(--duration-base) var(--ease-out),
            border-color var(--duration-base) var(--ease-out);
    }
    .arrow:hover {
        background-color: rgba(11, 15, 25, 0.85);
        border-color: rgba(255, 255, 255, 0.35);
    }
    .arrow.previous {
        left: 1em;
    }
    .arrow.next {
        right: 1em;
    }
    .indicators {
        display: flex;
        justify-content: center;
        gap: 0.5em;
        margin-top: 1em;
        margin-bottom: 0.5em;
    }
    .indicator {
        width: 28px;
        height: 12px;
        padding: 0;
        border-radius: var(--radius-full);
        background-color: rgba(255, 255, 255, 0.25);
        border: none;
        cursor: pointer;
        transition:
            background-color var(--duration-base) var(--ease-out),
            width var(--duration-base) var(--ease-out);
    }
    .indicator:hover {
        background-color: rgba(255, 255, 255, 0.45);
    }
    .indicator.active {
        background-color: var(--accent);
        width: 40px;
        cursor: default;
    }
    @media screen and (max-width: 750px) {
        .slide .caption {
            position: inherit;
            padding: 0.6em 1em 0;
            border-radius: 0;
            text-shadow: none;
        }
        .arrow {
            width: 38px;
            height: 38px;
        }
    }
</style>
