---
import Image from "astro/components/Image.astro";
import DiscordLink from "./DiscordLink.astro";
import Link from "./Link.astro";
import LogoImg from "../assets/logo.png"

const currentYear = new Date().getFullYear();
---

<footer>
    <div class="container">
        <div class="brand">
            <a href="/">
                <Image src={LogoImg} alt="CloudCraft Logo" aria-hidden="true" width={48} height={48}/>
                <span>CloudCraft</span>
            </a>
            <p>Der Minecraft Projekte Discord - hier entstehen gemeinsam unvergessliche Projekte.</p>
        </div>
        <nav class="groups">
            <div>
                <DiscordLink noIcon/>
                <Link href="/r/instagram">Instagram</Link>
                <Link href="/r/tiktok">TikTok</Link>
                <Link href="/r/youtube">YouTube</Link>
                <Link href="/r/github">GitHub</Link>
            </div>
            <div>
                <Link href="/projects/">Projekte</Link>
                <Link href="/downloads/">Downloads</Link>
                <Link href="/r/apply">Bewerben</Link>
            </div>
            <div>
                <Link href="/rules">Regeln</Link>
                <Link href="/faq/">FAQ</Link>
                <Link href="/r/status">Status</Link>
                <Link href="/faq/#contact">Kontakt</Link>
            </div>
        </nav>
    </div>
    <div class="bottom">
        <p>© {currentYear} CloudCraft. Made with {Astro.generator}.</p>
        <p>NOT AN OFFICIAL MINECRAFT PRODUCT.<br/>NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.</p>
    </div>
</footer>

<style>
    footer {
        margin-top: auto;
        background-color: var(--bg-alt);
        border-top: 1px solid var(--border);
        padding: 3.5em 1em 0 1em;
    }
    .container {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 3em;
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
        padding-bottom: 3em;
    }
    .brand {
        max-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 1em;
    }
    .brand a {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        color: var(--text);
        text-decoration: none;
        font-size: 1.2rem;
        font-weight: 700;
    }
    .brand img {
        width: 36px;
        height: 36px;
    }
    .brand p {
        color: var(--text-muted);
        margin: 0;
    }
    .groups {
        display: flex;
        flex-wrap: wrap;
        gap: 3em;
    }
    .groups > div {
        display: flex;
        flex-direction: column;
        gap: 0.55em;
    }
    .groups :global(a) {
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--duration-base) var(--ease-out);
    }
    .groups :global(a:hover) {
        color: var(--text);
    }
    .bottom {
        border-top: 1px solid var(--border);
        padding: 1.5em 1em;
        text-align: center;
        color: var(--text-faint);
        font-size: 0.85rem;
        user-select: none;
    }
    .bottom p {
        margin: 0.3em 0;
    }
</style>
