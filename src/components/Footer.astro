---
import DiscordLink from "./DiscordLink.astro";
import Link from "./Link.astro";
import BaselineDownloadIcon from "~icons/ic/baseline-download";
import InstagramIcon from "~icons/simple-icons/instagram";
import BaselineTiktokIcon from "~icons/ic/baseline-tiktok";
import YoutubeIcon from "~icons/simple-icons/youtube";
import GithubIcon from "~icons/simple-icons/github";
import BaselineMailIcon from "~icons/ic/baseline-mail";
import BaselineSignalCellularAltIcon from "~icons/ic/baseline-signal-cellular-alt";
import BaselineContactPageIcon from "~icons/ic/baseline-contact-page";

const currentYear = new Date().getFullYear();
---

<footer>
  <span>© {currentYear} CloudCraft. Made with {Astro.generator}.</span>
  <span>NOT AN OFFICIAL MINECRAFT PRODUCT.<br />NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.</span>
  <nav class="links">
    <Link icon={BaselineDownloadIcon} href="/r/downloads">Downloads</Link>
    <Link icon={InstagramIcon} href="/r/instagram">Instagram</Link>
    <Link icon={BaselineTiktokIcon} href="/r/tiktok">TikTok</Link>
    <Link icon={YoutubeIcon} href="/r/youtube">YouTube</Link>
    <DiscordLink />
    <Link icon={GithubIcon} href="/r/github">GitHub</Link>
    <Link icon={BaselineMailIcon} href="/r/apply">Bewerben</Link>
    <Link icon={BaselineSignalCellularAltIcon} href="/r/status">Status</Link>
    <Link icon={BaselineContactPageIcon} href="/faq/#contact">Kontakt</Link>
  </nav>
</footer>
<style>
  footer {
    flex: 1;
    padding: 3em 1em;
    text-align: center;
    background-color: rgb(33, 37, 41);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1em;
  }
  .links {
    display: flex;
    gap: 1em;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
