---
interface Props {
    title: string;
}

const {title} = Astro.props;
---

<header class="page-header">
    <div class="container">
        <h1>{title}</h1>
        <slot/>
    </div>
</header>

<style>
    .page-header {
        border-bottom: 1px solid var(--border);
        padding: 3em 1em 2.5em;
    }
    .container {
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
    }
    .page-header h1 {
        margin-bottom: 0.4em;
    }
    .page-header :global(p) {
        color: var(--text-muted);
        max-width: 65ch;
        margin: 0px 0px 0.75em;
    }
    .page-header :global(p:last-child) {
        margin-bottom: 0px;
    }
</style>
