---
import type {SvgComponent} from "astro/types";
import Button, {type ButtonProps} from "./Button.astro";

interface Props {
    icon?: SvgComponent;
    href: string;
    bold?: boolean;
    noColor?: boolean;
    button?: boolean | ButtonProps;
}

const {icon: Icon, href, bold, noColor, button: rbtn} = Astro.props;
const button = !rbtn ? undefined : (typeof rbtn === "boolean" ? {} : rbtn); // convert "true" to empty props

const classNames = [];
if (bold) classNames.push("bold");
if (noColor) classNames.push("no-color");
if (!button) classNames.push("text-link");
const className = classNames.length > 0 ? classNames.join(" ") : undefined;
---

<a href={href} class={className}>{
    button ?
        <Button {...button}>
            {Icon &&
                <Icon aria-hidden="true"/>}
            <slot>{href}</slot>
        </Button>
        :
        <>{Icon && <Icon aria-hidden="true"/>} <slot>{href}</slot></>
}</a>

<style>
    a {
        transition: color var(--duration-base) var(--ease-out),
        text-decoration-color var(--duration-base) var(--ease-out);
        text-wrap: nowrap;
    }

    a svg {
        margin-left: 0.1em;
        vertical-align: -0.15em;
    }

    a.text-link {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
        text-underline-offset: 3px;
    }

    a.text-link:hover {
        color: var(--accent-hover);
        text-decoration-color: currentColor;
    }

    a.bold {
        font-weight: 600;
    }

    a.no-color {
        color: var(--text);
        text-decoration-color: rgba(255, 255, 255, 0.35);
    }

    a.no-color:hover {
        color: var(--text-muted);
        text-decoration-color: currentColor;
    }
</style>
