---
import type {CollectionEntry} from "astro:content";
import GithubIcon from "~icons/simple-icons/github";
import BaselineDownloadIcon from "~icons/ic/baseline-download";
import BaselineArchiveIcon from "~icons/ic/baseline-archive";
import Button from "./Button.astro";

interface Props {
    entry: CollectionEntry<"downloadTools">;
}

const {entry} = Astro.props;
const {title, description, archived, github, download} = entry.data;

const href = download ? `/download/tool/${entry.id}` : undefined;
---

<article class="card">
    <div class="head">
        <h3>{title}</h3>
        {archived && <span class="chip"><BaselineArchiveIcon aria-hidden="true"/>Archiviert</span>}
    </div>
    {description && <p class="desc">{description}</p>}
    <div class="links">
        <a class="link" href={github}>
            <Button variant="secondary">
                <GithubIcon aria-hidden="true"/>
                <span>Quellcode</span>
            </Button>
        </a>
        {
            href && (
                <a class="link" href={href}>
                    <Button variant="primary">
                        <BaselineDownloadIcon aria-hidden="true"/>
                        <span>Download</span>
                    </Button>
                </a>
            )
        }
    </div>
</article>

<style>
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.75em;
        height: 100%;
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 1.25em 1.35em 1.35em;
    }
    .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75em;
        flex-wrap: wrap;
    }
    .head h3 {
        font-size: 1.25rem;
        margin: 0;
    }
    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.25em 0.7em;
        border-radius: var(--radius-full);
        background-color: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        line-height: 1.4;
    }
    .desc {
        color: var(--text-muted);
        margin: 0;
        font-size: 0.95rem;
        flex: 1;
    }
    .links {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75em;
        flex-wrap: wrap;
    }
    .links .link {
        flex: 1;
    }
    .links .link :global(.btn) {
        width: 100%;
    }
</style>
