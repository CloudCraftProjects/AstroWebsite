---
import NavbarLink from "./NavbarLink.astro";
import BaselineHomeIcon from "~icons/ic/baseline-home";
import BaselineNewspaperIcon from "~icons/ic/baseline-newspaper";
import BaselineHelpIcon from "~icons/ic/baseline-help";
import BaselineDiscordIcon from "~icons/ic/baseline-discord";
import BaselineMenuIcon from "~icons/ic/baseline-menu";
import BaselineCloseIcon from "~icons/ic/baseline-close";
import Image from "astro/components/Image.astro";
import LogoImg from "../assets/logo.png"
---

<header class="nav">
    <div class="container">
        <a class="brand" href="/">
            <Image aria-hidden="true" src={LogoImg} alt="CloudCraft Logo" width={48} height={48}/>
            <span>CloudCraft</span>
        </a>
        <nav class="links" id="site-nav" aria-label="Hauptnavigation">
            <NavbarLink icon={BaselineHomeIcon} href="/">Home</NavbarLink>
            <NavbarLink icon={BaselineNewspaperIcon} href="/projects/">Projekte</NavbarLink>
            <NavbarLink icon={BaselineHelpIcon} href="/faq/">FAQ</NavbarLink>
            <a class="discord" href="/r/discord">
                <BaselineDiscordIcon aria-hidden="true"/>
                <span>Discord</span>
            </a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
            <BaselineMenuIcon class="icon-open" aria-hidden="true"/>
            <BaselineCloseIcon class="icon-close" aria-hidden="true"/>
            <span class="sr-only">Menü umschalten</span>
        </button>
    </div>
</header>

<script>
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
    const nav = document.getElementById("site-nav")!;
    const setOpen = (open: boolean) => {
        nav.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: var(--bg-alt);
        border-bottom: 1px solid var(--border);
        padding: 0.25em 0;
    }
    .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
        padding: 0.75em 1em;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        color: var(--text);
        border-radius: var(--radius-md);
        text-decoration: none;
        font-size: 1.2rem;
        font-weight: 700;
    }
    .brand img {
        width: 32px;
        height: 32px;
    }
    .links {
        display: flex;
        align-items: center;
        gap: 0.35em;
    }
    .links .discord {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        margin-left: 0.75em;
        padding: 0.5em 1.15em;
        border-radius: var(--radius-lg);
        background-color: var(--discord);
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        transition: background-color var(--duration-base) var(--ease-out);
    }
    .links .discord:hover {
        background-color: var(--discord-highlight);
    }
    .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: var(--radius-md);
        background-color: transparent;
        border: 1px solid var(--border-strong);
        color: var(--text);
        font: inherit;
        cursor: pointer;
        transition:
            background-color var(--duration-base) var(--ease-out),
            border-color var(--duration-base) var(--ease-out);
    }
    .menu-toggle:hover {
        background-color: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.3);
    }
    .menu-toggle .icon-close {
        display: none;
    }
    .menu-toggle[aria-expanded="true"] .icon-open {
        display: none;
    }
    .menu-toggle[aria-expanded="true"] .icon-close {
        display: block;
    }
    @media screen and (max-width: 768px) {
        .menu-toggle {
            display: inline-flex;
        }
        .links {
            display: none;
            position: absolute;
            top: 100%;
            left: 0px;
            right: 0px;
            flex-direction: column;
            align-items: stretch;
            gap: 0.5em;
            background-color: var(--bg-alt);
            border-bottom: 1px solid var(--border);
            padding: 1em 1.25em 1.25em;
        }
        .links.open {
            display: flex;
        }
        .links .discord {
            margin-left: 0px;
            margin-top: 0.5em;
            justify-content: center;
        }
    }
</style>
