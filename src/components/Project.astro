---
import {Image} from "astro:assets";
import Badge from "./Badge.astro";
import Tooltip from "./Tooltip.astro";
import type {CollectionEntry} from "astro:content";
import * as path from "node:path";
import BaselineDiscordIcon from "~icons/ic/baseline-discord";
import BaselineArrowForwardIcon from "~icons/ic/baseline-arrow-forward";

interface Props {
    data: CollectionEntry<"categories">;
    running: boolean;
}

const {filePath, data: {name, previewImage, description}} = Astro.props.data;
const id = path.dirname(filePath!).split("/").at(-1);
---

<article class="card">
    <a class="card-link" href={`/projects/${id}/`} aria-label={`Mehr über ${name} erfahren`}></a>
    <div class="image">
        <Image
            src={`/assets/projects/${id}/${previewImage}.webp`}
            width="406"
            height="270"
            alt={`Vorschaubild von ${name}`}
        />
    </div>
    {
        Astro.props.running && (
            <div class="badge">
                <Tooltip text="Anmeldung im Discord">
                    <a href="/r/discord" aria-label="Aktuelles Projekt - Anmeldung im Discord">
                        <Badge icon={BaselineDiscordIcon}>Aktuell</Badge>
                    </a>
                </Tooltip>
            </div>
        )
    }
    <div class="info">
        <h2>{name}</h2>
        <p>{description}</p>
        <span class="more">
            Mehr erfahren
            <BaselineArrowForwardIcon aria-hidden="true"/>
        </span>
    </div>
</article>
<style>
    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        transition: border-color var(--duration-base) var(--ease-out);
    }
    .card:hover {
        border-color: var(--accent-border);
    }
    .card-link {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: var(--radius-lg);
    }
    .image {
        overflow: hidden;
        border-top-left-radius: calc(var(--radius-lg) - 1px);
        border-top-right-radius: calc(var(--radius-lg) - 1px);
        aspect-ratio: 3 / 2;
    }
    .image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--duration-base) var(--ease-out);
    }
    .card:hover .image img {
        transform: scale(1.02);
    }
    .badge {
        position: absolute;
        top: 0.6em;
        left: 0.6em;
        z-index: 2;
    }
    .badge a {
        text-decoration: none;
    }
    .info {
        display: flex;
        flex-direction: column;
        gap: 0.5em;
        flex: 1;
        padding: 1.25em 1.35em 1.35em;
    }
    .info h2 {
        font-size: 1.4rem;
        margin: 0px;
    }
    .info p {
        color: var(--text-muted);
        margin: 0px;
        flex: 1;
    }
    .more {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        color: var(--accent);
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>
